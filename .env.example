# Copy to .env and adjust: cp .env.example .env
# .env is git-ignored. These values are placeholders for a local stack only;
# never reuse them anywhere else.

# MySQL (used by the db service, and passed to the app as DB_*)
MYSQL_DATABASE=votingweb
MYSQL_USER=votingweb
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Flask
# Generate a real key with: openssl rand -base64 64
FLASK_SECRET_KEY=change-me
FLASK_DEBUG=0

# Host port for the voting page (http://localhost:8080)
APP_PORT=8080
